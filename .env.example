# Server
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/factory.db
FACTORY_API_KEY=
# JWT secret for embed tokens (falls back to FACTORY_API_KEY when empty)
EMBED_TOKEN_SECRET=
# Passphrase for encrypting model provider API keys at rest (Fernet).
# Falls back to FACTORY_API_KEY → EMBED_TOKEN_SECRET → weak dev default.
# Changing this makes existing sealed keys undecryptable — re-enter them in admin.
MODEL_SECRETS_KEY=AGENT_FACTORY_SECRET_KEY
CORS_ORIGINS=http://localhost:8801,http://localhost:8802,http://localhost:8803

# OpenAI-compatible LLM
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Per-run cost guards (Agent.runtime overrides these)
# MAX_TOOL_ROUNDS=8
# MAX_RUN_TOKENS=1000000
# TOOL_TIMEOUT_SECONDS=30

# Frontend (Vite)
VITE_API_BASE=http://127.0.0.1:8000
VITE_CHAT_WEB_ORIGIN=http://localhost:8801
VITE_FACTORY_API_KEY=
